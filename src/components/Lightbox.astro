---
import type { Locale } from '../config/site';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<dialog
  class="lb"
  data-lightbox-dialog
  aria-label=""
  data-label-prev={t(locale, 'previous')}
  data-label-next={t(locale, 'next')}
>
  <div class="lb__stage" data-lb-stage>
    <img class="lb__img" data-lb-img alt="" />
  </div>
  <button type="button" class="lb__btn lb__close" data-lb-close aria-label={t(locale, 'close')}>
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    >
      <path d="M5 5l14 14M19 5L5 19"></path>
    </svg>
  </button>
  <button type="button" class="lb__btn lb__prev" data-lb-prev aria-label={t(locale, 'previous')}>
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M15 5l-7 7 7 7"></path>
    </svg>
  </button>
  <button type="button" class="lb__btn lb__next" data-lb-next aria-label={t(locale, 'next')}>
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
  <p class="lb__count" data-lb-count aria-live="polite"></p>
</dialog>

<style>
  .lb {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--black);
    color: var(--white);
    overscroll-behavior: contain;
  }
  .lb::backdrop {
    background: var(--black);
  }
  .lb[open] {
    display: grid;
    animation: lb-in 0.25s var(--ease);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: max(56px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right))
      max(56px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
    touch-action: none;
  }
  .lb__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2px;
    transition:
      transform 0.25s var(--ease),
      opacity 0.25s var(--ease);
    user-select: none;
    -webkit-user-drag: none;
  }
  .lb__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--white);
    opacity: 0.7;
    transition: opacity 0.2s var(--ease);
  }
  .lb__btn:hover,
  .lb__btn:focus-visible {
    opacity: 1;
  }
  .lb__btn:focus-visible {
    outline-color: var(--white);
    outline-offset: 0;
  }
  .lb__close {
    top: max(8px, env(safe-area-inset-top));
    right: max(8px, env(safe-area-inset-right));
  }
  .lb__prev,
  .lb__next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb__prev {
    left: max(4px, env(safe-area-inset-left));
  }
  .lb__next {
    right: max(4px, env(safe-area-inset-right));
  }
  .lb__count {
    position: absolute;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--paper-70);
  }
  .lb.is-single .lb__prev,
  .lb.is-single .lb__next,
  .lb.is-single .lb__count {
    display: none;
  }
  :global(html.lb-open) {
    overflow: hidden;
  }
</style>

<script>
  import { initLightbox } from '../lib/lightbox';
  initLightbox();
</script>
